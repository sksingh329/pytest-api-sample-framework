# Copy this file to .env (gitignored -- never commit real tokens) and fill
# in the values you have. .env is loaded automatically by the root
# conftest.py before any test runs.
#
# Convention: <API_ENV>_<ROLE>_TOKEN, uppercase. core.auth.TokenProvider
# looks up exactly this name for a given (environment, role) pair -- e.g.
# TokenProvider(settings).get_token("read") while api_env=dev looks up
# DEV_READ_TOKEN. A role with no matching var here is a ConfigError -- API
# tests use a fixed bearer token, there's nothing to fall back to.
#
# "default" is the role ApiClient/TokenProvider use when a test doesn't
# name one (core.auth.DEFAULT_ROLE), so most suites need at least
# <API_ENV>_DEFAULT_TOKEN filled in. Add more ROLE names as your API needs
# them (admin, viewer, service-to-service, ...) -- nothing else needs to
# change, TokenProvider derives the variable name from api_env + whatever
# role string a test passes it.

DEV_DEFAULT_TOKEN=
DEV_READ_TOKEN=
DEV_WRITE_TOKEN=

STAGE_DEFAULT_TOKEN=
STAGE_READ_TOKEN=
STAGE_WRITE_TOKEN=

PROD_DEFAULT_TOKEN=
PROD_READ_TOKEN=
PROD_WRITE_TOKEN=
